# Day 25 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================================
# 本地模型部署配置
# ============================================================

# 模型路径（GGUF/GPTQ/HF格式）
MODEL_PATH=/path/to/local/model.gguf

# GPU显存利用率（0.0-1.0）
GPU_MEMORY_UTILIZATION=0.9

# 最大上下文长度
MAX_MODEL_LEN=4096

# 量化配置
QUANTIZATION=q4_k_m

# ============================================================
# API服务配置
# ============================================================

# 服务地址
API_HOST=127.0.0.1
API_PORT=8000

# 最大并发请求
MAX_CONCURRENT_REQUESTS=10

# ============================================================
# 隐私计算配置
# ============================================================

# 差分隐私参数
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_SENSITIVITY=1.0

# 加密密钥（用于演示，实际使用应使用安全生成的密钥）
ENCRYPTION_KEY=your_secure_key_16b

# 哈希盐值
HASH_SALT=privacy_salt

# ============================================================
# 联邦学习配置
# ============================================================

# 训练轮数
NUM_ROUNDS=10

# 本地训练轮数
LOCAL_EPOCHS=5

# 学习率
LEARNING_RATE=0.01

# 隐私预算
FL_EPSILON=1.0

# ============================================================
# 其他配置
# ============================================================

# HuggingFace Token（如需要下载模型）
HF_TOKEN=your_huggingface_token

# Wandb API Key（可选，用于实验跟踪）
WANDB_API_KEY=your_wandb_key