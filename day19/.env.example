# DeepSeek API 配置（主要使用）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# OpenAI API 配置（可选，某些框架默认使用）
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Semantic Kernel 配置
# Semantic Kernel 使用 OpenAI 兼容接口
# 配置与 DEEPSEEK 配置相同即可

# Dify 平台配置（可选）
# 从 Dify 应用设置页面获取 API Key
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=your_dify_api_key_here

# AutoGen 配置
# AutoGen 使用 OpenAI 兼容的 config_list 配置
# 代码执行相关配置
AUTOGEN_CODE_EXECUTION=true
AUTOGEN_WORK_DIR=./day19/coding

# Azure OpenAI 配置（可选，用于企业场景）
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# 嵌入模型配置（可选，用于 RAG 功能）
EMBEDDING_MODEL=text-embedding-3-small
# 如果使用其他嵌入服务
# EMBEDDING_API_KEY=your_embedding_key
# EMBEDDING_BASE_URL=https://api.example.com