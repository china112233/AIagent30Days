# Day 27 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================================
# 延迟优化配置
# ============================================================

# 首 Token 延迟目标（毫秒）
TTFT_TARGET_MS=500

# 总延迟目标（毫秒）
LATENCY_TARGET_MS=2000

# 是否启用流式输出
STREAMING_ENABLED=true

# KV Cache 最大缓存数量
KV_CACHE_MAX_SIZE=100

# 是否启用模型预热
PREHEAT_ENABLED=true

# ============================================================
# 成本控制配置
# ============================================================

# 每日预算上限（美元）
DAILY_BUDGET=100.0

# 每周预算上限
WEEKLY_BUDGET=700.0

# 每月预算上限
MONTHLY_BUDGET=3000.0

# 预算告警阈值（百分比）
BUDGET_ALERT_THRESHOLD=80

# 默认模型（影响成本）
DEFAULT_MODEL=claude-3-sonnet

# ============================================================
# 缓存配置
# ============================================================

# 是否启用缓存
CACHE_ENABLED=true

# 结果缓存 TTL（秒）
RESULT_CACHE_TTL=3600

# 嵌入缓存 TTL（秒）
EMBEDDING_CACHE_TTL=86400

# 会话缓存 TTL（秒）
SESSION_CACHE_TTL=3600

# L1 内存缓存最大条目数
L1_CACHE_MAX_SIZE=1000

# L2 Redis 缓存最大条目数
L2_CACHE_MAX_SIZE=10000

# 缓存相似度阈值（嵌入缓存）
SIMILARITY_THRESHOLD=0.95

# ============================================================
# 并发配置
# ============================================================

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=100

# 请求队列最大长度
MAX_QUEUE_SIZE=500

# Worker 数量
WORKER_COUNT=10

# 全局限流（每秒请求数）
GLOBAL_RPS=1000

# 单用户限流（每秒请求数）
USER_RPS=50

# 令牌桶容量
TOKEN_BUCKET_CAPACITY=100

# 令牌生成速率
TOKEN_BUCKET_RATE=50

# ============================================================
# Redis 配置（用于分布式缓存）
# ============================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# 监控配置
# ============================================================

# 是否启用性能监控
METRICS_ENABLED=true

# Prometheus 指标端口
METRICS_PORT=9090

# 日志级别
LOG_LEVEL=INFO

# 是否记录详细延迟日志
VERBOSE_LATENCY_LOGGING=false

# ============================================================
# 超时配置
# ============================================================

# 请求超时（秒）
REQUEST_TIMEOUT=30

# 连接超时（秒）
CONNECT_TIMEOUT=10

# 读超时（秒）
READ_TIMEOUT=30

# ============================================================
# 重试配置
# ============================================================

# 最大重试次数
MAX_RETRIES=3

# 重试间隔基数（秒）
RETRY_BASE_DELAY=1

# 是否启用指数退避
EXponential_BACKOFF=true