# day24/.env.example
# Day 24: 模型微调入门 - 环境变量示例

# Hugging Face 令牌（可选，用于访问私有模型）
HF_TOKEN=your_huggingface_token_here

# Weights & Biases 令牌（可选，用于实验跟踪）
WANDB_API_KEY=your_wandb_api_key_here

# 模型配置
MODEL_NAME=microsoft/DialoGPT-medium
# 或者使用其他模型
# MODEL_NAME=gpt2
# MODEL_NAME=EleutherAI/gpt-j-6B

# 训练配置
LEARNING_RATE=5e-4
BATCH_SIZE=4
NUM_EPOCHS=3
MAX_SEQ_LENGTH=512

# LoRA配置
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1
TARGET_MODULES=q_proj,v_proj